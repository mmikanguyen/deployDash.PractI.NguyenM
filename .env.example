# Copy to .env for local use. Never commit .env or ca.pem.
DB_HOST=your-service-your-project.f.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=change-me

# Aiven requires TLS. Download ca.pem from the service page in the Aiven console,
# save it in this folder, and point to it:
DB_SSL_CA=./ca.pem
# On hosts without file uploads, paste the PEM text here instead (use \n for line breaks):
# DB_SSL_CA_PEM=

# Set to false only if certificate verification fails and you accept the risk
# DB_SSL_VERIFY=true

# Optional: protect the dashboard with a login
# DASH_USER=
# DASH_PASS=

# Show real error messages in the dashboard while setting up
# APP_DEBUG=1

# Only if your table names differ in case (MySQL on Linux is case-sensitive)
# TBL_VISITS=Visits
# TBL_BILLS=Bills
# TBL_RESTAURANTS=Restaurants
# TBL_SERVERS=Servers
# TBL_CUSTOMERS=Customers
# TBL_MEAL=Meal
# TBL_PAYMENT=Payment
